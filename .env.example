# Copy to .env.local. Never publish this file with real credentials.
NEXT_PUBLIC_SITE_URL=https://www.absproperties.uk
# Set false when checking the production site. Examples never appear in production.
SHOW_DEMO_LISTINGS=true
# Server only. Verify a sending domain in Resend before enabling enquiries.
RESEND_API_KEY=
ENQUIRY_FROM=
ENQUIRY_TO=info@abs-properties.co.uk
# Required for production form submissions. Create a Cloudflare Turnstile widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local-demo admin only. Do not use this auth or JSON persistence for production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-local-secret
